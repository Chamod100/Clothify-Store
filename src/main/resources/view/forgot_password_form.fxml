<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="649.0" prefWidth="939.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.ForgotPasswordFormController">
    <children>
        <ImageView fitHeight="650.0" fitWidth="943.0" layoutY="-1.0" pickOnBounds="true">
            <image>
                <Image url="@../image/wu-yi-Bx_Iq59ZHKY-unsplash.jpg" />
            </image>
        </ImageView>
        <Rectangle arcHeight="5.0" arcWidth="5.0" height="650.0" layoutX="-1.0" layoutY="-1.0" opacity="0.49" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" width="943.0">
            <cursor>
                <Cursor fx:constant="DEFAULT" />
            </cursor>
        </Rectangle>
        <Label layoutX="96.0" layoutY="36.0" text="Forgot Password" textFill="WHITE">
            <font>
                <Font name="System Bold" size="27.0" />
            </font>
        </Label>
        <ImageView fitHeight="56.0" fitWidth="51.0" layoutX="31.0" layoutY="25.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../image/icons8-clothing-store.png" />
            </image>
        </ImageView>
        <Rectangle arcHeight="50.0" arcWidth="50.0" height="492.0" layoutX="65.0" layoutY="101.0" opacity="0.43" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" width="814.0">
            <cursor>
                <Cursor fx:constant="DEFAULT" />
            </cursor>
        </Rectangle>
        <Label layoutX="262.0" layoutY="325.0" text="New Password" textFill="WHITE">
            <font>
                <Font name="System Bold" size="14.0" />
