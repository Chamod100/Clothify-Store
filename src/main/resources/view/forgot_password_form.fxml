        <JFXTextField fx:id="txtOtp" disable="true" focusColor="WHITE" layoutX="616.0" layoutY="221.0" prefHeight="25.0" prefWidth="93.0" promptText="*  *  *  *" style="-fx-background-color: white;" unFocusColor="#ffaaaa" />
        <JFXButton layoutX="530.0" layoutY="222.0" onAction="#btnSentOtpOnAction" prefHeight="25.0" prefWidth="75.0" style="-fx-background-color: #2ecc71;" text="Send OTP" textFill="WHITE">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </JFXButton>
        <JFXButton fx:id="btnOk" disable="true" layoutX="718.0" layoutY="221.0" onAction="#btnOkOtpOnAction" prefHeight="18.0" prefWidth="42.0" style="-fx-background-color: #f39c12;" text="OK" textFill="WHITE">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </JFXButton>
        <Label layoutX="125.0" layoutY="149.0" text="If you forgot your password, Then click the button send the OTP and enter the below " textFill="WHITE">
            <font>
                <Font size="15.0" />
            </font></Label>
        <Label layoutX="124.0" layoutY="170.0" text="text field that received pin on your email. Then you can change your password." textFill="WHITE">
            <font>
                <Font size="15.0" />
            </font></Label>
        <Label layoutX="259.0" layoutY="407.0" text="Confirm Password* :" textFill="WHITE">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <JFXPasswordField fx:id="txtPassword" disable="true" layoutX="427.0" layoutY="321.0" prefHeight="25.0" prefWidth="273.0" promptText="new password" style="-fx-background-color: white;" unFocusColor="#ffaaaa" />
        <JFXPasswordField fx:id="txtConfirmPassword" disable="true" layoutX="427.0" layoutY="401.0" prefHeight="25.0" prefWidth="273.0" promptText="confirm password" style="-fx-background-color: white;" unFocusColor="#ffaaaa" />
        <JFXCheckBox layoutX="592.0" layoutY="447.0" text="Show Password" textFill="WHITE" unCheckedColor="#ffaaaa" />
        <JFXButton fx:id="btnSaved" disable="true" layoutX="748.0" layoutY="542.0" onAction="#btnSavedOnAction" prefHeight="31.0" prefWidth="93.0" style="-fx-background-color: #2ecc71;" text="Save" textFill="WHITE">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </JFXButton>
        <JFXButton ellipsisString="" layoutX="877.0" layoutY="34.0" onAction="#backBtnOnAction" prefHeight="59.0" prefWidth="65.0" textAlignment="CENTER" textFill="WHITE" textOverrun="WORD_ELLIPSIS">
            <font>
                <Font size="1.0" />
            </font>
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </JFXButton>
        <Label layoutX="127.0" layoutY="225.0" text="Enter Your Email" textFill="WHITE">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <JFXTextField fx:id="txtEmail" layoutX="252.0" layoutY="222.0" prefHeight="25.0" prefWidth="266.0" promptText="email on your exsist account" style="-fx-background-color: white;" />
          <ImageView fitHeight="41.0" fitWidth="46.0" layoutX="872.0" layoutY="36.0" pickOnBounds="true" preserveRatio="true">
              <image>
                  <Image url="@../image/icons8-back-100.png" />
              </image>
          </ImageView>
    </children>
</AnchorPane>
